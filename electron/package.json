{
  "name": "medconnect-desktop",
  "version": "2.11.2",
  "description": "MedConnect — application de bureau (Windows + Linux)",
  "main": "main.js",
  "homepage": "https://medconnect-e81ba.web.app/",
  "author": {
    "name": "Media Vision",
    "email": "contact@mediavision.app"
  },
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "predist:win": "node ../scripts/sync-desktop-version.mjs",
    "dist:win": "electron-builder --win",
    "predist:linux": "node ../scripts/sync-desktop-version.mjs",
    "dist:linux": "electron-builder --linux",
    "predist:store": "node ../scripts/sync-desktop-version.mjs",
    "dist:store": "electron-builder --win appx"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mediavision.medconnect.desktop",
    "productName": "MedConnect",
    "directories": {
      "output": "dist",
      "buildResources": "build-resources"
    },
    "files": [
      "main.js",
      "offline.html",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png",
      "artifactName": "MedConnect-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "artifactName": "MedConnect-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appx": {
      "identityName": "DavidKabengele.Medconnectapps",
      "publisher": "CN=DE2F36F7-77D2-4F3B-88A1-0A723818E3C3",
      "publisherDisplayName": "David Kabengele",
      "applicationId": "MedConnect",
      "displayName": "Medconnect santé",
      "languages": [
        "fr-FR",
        "en-US"
      ],
      "backgroundColor": "transparent",
      "showNameOnTiles": true,
      "artifactName": "MedConnect-${version}-store.${ext}"
    }
  }
}
